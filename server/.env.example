PORT=5000
NODE_ENV=development

MONGODB_URL=

BREVO_API_KEY=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

SECRET_KEY_ACCESS_TOKEN=
SECRET_KEY_REFRESH_TOKEN=

BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Faith & Fast

JWT_SECRET=
